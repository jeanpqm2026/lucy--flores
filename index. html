
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Para Lucy 💛</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #fff8c9, #ffd86b, #fff3a6);
}

.card {
  width: min(92vw, 430px);
  padding: 28px 22px 30px;
  text-align: center;
  background: rgba(255,255,255,.93);
  border-radius: 28px;
  box-shadow: 0 18px 45px rgba(130,95,0,.22);
  animation: aparecer 1.2s ease;
}

h1 {
  margin: 0 0 10px;
  color: #d99a00;
  font-size: 2.2rem;
}

.mensaje {
  color: #654f16;
  font-size: 1.05rem;
  line-height: 1.55;
}

.ramo {
  position: relative;
  width: 240px;
  height: 245px;
  margin: 0 auto;
}

.papel {
  position: absolute;
  left: 50%;
  bottom: 5px;
  transform: translateX(-50%);
  width: 155px;
  height: 135px;
  background: linear-gradient(145deg, #ffe27b, #f6bf28);
  clip-path: polygon(10% 0,90% 0,100% 100%,0 100%);
  border-radius: 8px;
}

.tallo {
  position: absolute;
  bottom: 65px;
  left: 50%;
  width: 7px;
  height: 130px;
  background: #6c9a3a;
  border-radius: 8px;
  transform-origin: bottom;
}

.t1 {
  transform: translateX(-50%) rotate(-20deg);
}

.t2 {
  transform: translateX(-50%);
}

.t3 {
  transform: translateX(-50%) rotate(20deg);
}

.hoja {
  position: absolute;
  width: 42px;
  height: 18px;
  background: #75a83f;
  border-radius: 100% 0 100% 0;
}

.h1 {
  left: 53px;
  bottom: 95px;
  transform: rotate(25deg);
}

.h2 {
  right: 53px;
  bottom: 105px;
  transform: scaleX(-1) rotate(25deg);
}

.flor {
  position: absolute;
  width: 70px;
  height: 70px;
  left: 50%;
  top: 24px;
  transform: translateX(-50%);
  animation: mover 3s ease-in-out infinite;
}

.flor::before,
.flor::after {
  content: "";
  position: absolute;
  inset: 0;
  background: #ffd21c;
  border-radius: 50%;
  box-shadow:
    0 -25px 0 #ffd21c,
    0 25px 0 #ffd21c,
    25px 0 0 #ffd21c,
    -25px 0 0 #ffd21c;
}

.flor::after {
  transform: rotate(45deg);
}

.centro {
  position: absolute;
  z-index: 2;
  width: 34px;
  height: 34px;
  left: 18px;
  top: 18px;
  border-radius: 50%;
  background: #8b5a12;
}

.f2 {
  left: 29%;
  top: 43px;
  transform: translateX(-50%) scale(.72);
}

.f3 {
  left: 71%;
  top: 48px;
  transform: translateX(-50%) scale(.68);
}

.nota {
  display: inline-block;
  padding: 10px 20px;
  border-radius: 14px;
  background: #fffdf2;
  border: 1px solid #f1d36a;
  color: #c58b00;
  font-weight: bold;
  letter-spacing: 2px;
}

.final {
  margin-top: 18px;
  color: #a07b20;
  font-size: .88rem;
}

.caida {
  position: fixed;
  top: -30px;
  pointer-events: none;
  animation: caer linear forwards;
}

@keyframes caer {
  to {
    transform: translateY(110vh) rotate(360deg);
    opacity: .15;
  }
}

@keyframes mover {
  0%,100% {
    rotate: -2deg;
  }
  50% {
    rotate: 3deg;
  }
}

@keyframes aparecer {
  from {
    opacity: 0;
    transform: translateY(25px) scale(.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
</style>
</head>

<body>

<div class="card">

  <h1>Para Lucy 💛</h1>

  <div class="ramo">

    <div class="tallo t1"></div>
    <div class="tallo t2"></div>
    <div class="tallo t3"></div>

    <div class="hoja h1"></div>
    <div class="hoja h2"></div>

    <div class="flor">
      <div class="centro"></div>
    </div>

    <div class="flor f2">
      <div class="centro"></div>
    </div>

    <div class="flor f3">
      <div class="centro"></div>
    </div>

    <div class="papel"></div>

  </div>

  <div class="nota">
    LUCY 💛
  </div>

  <p class="mensaje">
    Gracias por estar, por tu buena vibra y por hacer la vida
    más bonita con tu amistad. ¡Eres increíble! 🌻
  </p>

  <div class="final">
    Un detalle de amistad para ti 💛
  </div>

</div>

<script>

const simbolos = ["🌻","💛","✨","🌼"];

function crearCaida() {

  const elemento = document.createElement("div");

  elemento.className = "caida";

  elemento.textContent =
    simbolos[Math.floor(Math.random() * simbolos.length)];

  elemento.style.left =
    Math.random() * 100 + "vw";

  elemento.style.fontSize =
    (14 + Math.random() * 18) + "px";

  elemento.style.animationDuration =
    (5 + Math.random() * 5) + "s";

  document.body.appendChild(elemento);

  setTimeout(() => {
    elemento.remove();
  }, 11000);
}

setInterval(crearCaida, 550);

</script>

</body>
</html>
